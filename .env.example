# Local dev (Docker Compose Postgres) - see docker-compose.yml
DATABASE_URL="postgresql://kitaabi:kitaabi@localhost:5432/kitaabi?schema=public"

# Auth.js session secret - generate with: npx auth secret
AUTH_SECRET="replace-with-a-random-secret"

# Public base URL, used for absolute links (sitemap, OG tags, hreflang)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Staging/Production only (set in Vercel project settings, not here) ---
# DATABASE_URL         -> Neon staging/main branch connection string
# AUTH_SECRET          -> distinct per environment
# NEXT_PUBLIC_APP_URL  -> the deployed URL for that environment
